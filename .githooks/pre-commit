#!/usr/bin/env bash
# Blocks commits that contain patterns suggesting private network data.
# Install: git config core.hooksPath .githooks

set -euo pipefail

STAGED=$(git diff --cached --name-only)

if [ -z "$STAGED" ]; then
  exit 0
fi

FAIL=0

# Ruff lint + format check on staged Python files
STAGED_PY=$(echo "$STAGED" | grep '\.py$' || true)
if [ -n "$STAGED_PY" ]; then
  if ! uv run ruff check $STAGED_PY 2>&1; then
    echo "ERROR: ruff lint failed. Run: uv run ruff check --fix dns_briefing/ tests/"
    FAIL=1
  fi
  if ! uv run ruff format --check $STAGED_PY 2>&1; then
    echo "ERROR: ruff format check failed. Run: uv run ruff format dns_briefing/ tests/"
    FAIL=1
  fi
fi

# Only scan TOML config files for private IP device maps — not test/code files.
# Pattern: quoted private IP followed by = (TOML key-value, e.g. "192.168.x.x" = "Device")
DEVICE_MAP_PATTERN='"(192\.168|10\.|172\.1[6-9]\.|172\.2[0-9]\.|172\.3[01]\.|100\.(6[4-9]|[7-9][0-9]|1[01][0-9]|12[0-7])\.)'

for f in $STAGED; do
  case "$f" in
    *.toml)
      if git show ":$f" 2>/dev/null | grep -qP "$DEVICE_MAP_PATTERN"; then
        echo "ERROR: $f appears to contain private IP addresses in a device map."
        echo "       Put device mappings in config.local.toml (gitignored), not committed files."
        FAIL=1
      fi
      ;;
  esac
done

# Block config.local.toml itself from ever being staged
if echo "$STAGED" | grep -q "config\.local\.toml$"; then
  echo "ERROR: config.local.toml is private and must never be committed."
  FAIL=1
fi

if [ "$FAIL" -eq 1 ]; then
  echo ""
  echo "Commit blocked. See above for details."
  exit 1
fi
